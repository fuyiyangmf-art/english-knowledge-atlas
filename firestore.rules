rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isExistingLearner() {
      return request.auth != null && request.auth.uid in [
        "28OZksHIcUUwzPOgHTwyFnZJzKq1",
        "9fizd35wQsfXZE2P05cTecfFIPO2",
        "pwtZ0J3OZbeznmcDhNyhmXeaX1E3",
        "wTVd7f6q0VTfW8qMsNYY7oYYyjh1"
      ];
    }

    match /config/content {
      allow read: if isExistingLearner();
      allow write: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isExistingLearner() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
